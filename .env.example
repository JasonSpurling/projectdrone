# Copy this file to .env and fill in real values. .env itself is
# gitignored -- never commit real credentials.

OPENSKY_CLIENT_ID=xxx           # optional; higher OpenSky rate limit (free account, register at opensky-network.org)
OPENSKY_CLIENT_SECRET=yyy
DETECTIONS_API_KEY=xxx          # required as X-API-Key header on POST /api/detections and other ingestion endpoints; if unset, ingestion is open to anyone with network access
ADSBLOL_REGIONS=NORTH_AMERICA         # free community ADS-B feed; CONUS, NORTH_AMERICA, "lat,lon;lat,lon;...", or unset to disable
AIRPLANESLIVE_REGIONS=NORTH_AMERICA   # second free community ADS-B feed, same options as above
# OPENAIP_API_KEY=xxx           # optional; worldwide restricted-airspace data (free key at openaip.net)
